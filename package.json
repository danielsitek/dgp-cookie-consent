{
  "name": "@danielsitek/dgp-cookie-consent",
  "version": "1.9.0",
  "description": "DGP cookie consent",
  "main": "dist/cookies.js",
  "types": "./types.d.ts",
  "files": [
    "dist",
    "./types.d.ts"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "build:tsc": "tsc --sourceMap=false --removeComments=true",
    "typecheck": "tsc --noEmit",
    "build": "gulp build",
    "build:prod": "gulp prod",
    "dev": "gulp",
    "clean": "rimraf dist",
    "serve": "http-server . -p 10001 -g",
    "lint:css": "stylelint \"src/**/*.css\""
  },
  "keywords": [
    "cookie",
    "cookiebar",
    "cookieconsent",
    "consent",
    "gdpr",
    "privacy",
    "privacybar",
    "privacyconsent"
  ],
  "author": "Daniel Sitek <dan.sitek@gmail.com>",
  "license": "MIT",
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^13.1.1",
    "@rollup/plugin-replace": "^3.0.0",
    "@rollup/plugin-typescript": "^8.3.0",
    "@types/node": "^24.19.2",
    "@typescript-eslint/eslint-plugin": "^5.7.0",
    "@typescript-eslint/parser": "^5.7.0",
    "autoprefixer": "^10.4.0",
    "browser-sync": "^2.27.7",
    "cssnano": "^5.0.13",
    "eslint": "^8.5.0",
    "eslint-config-prettier": "^8.3.0",
    "gulp": "^4.0.2",
    "gulp-cli": "^2.3.0",
    "gulp-eslint": "^6.0.0",
    "gulp-insert": "^0.5.0",
    "gulp-postcss": "^9.0.1",
    "gulp-rename": "^2.0.0",
    "gulp-strip-comments": "^2.5.2",
    "gulp-strip-debug": "^4.0.0",
    "gulp-terser": "^2.1.0",
    "happy-dom": "^21.0.4",
    "http-server": "^14.0.0",
    "postcss": "^8.4.5",
    "postcss-import": "^15.1.0",
    "rimraf": "^3.0.2",
    "rollup": "^2.61.1",
    "rollup-stream-gulp": "0.0.3",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-order": "^8.1.2",
    "tslib": "^2.3.1",
    "typescript": "^4.5.4",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "gulp-terser": {
      "terser": "5.10.0"
    }
  },
  "engines": {
    "node": "^24.0.0 || ^26.0.0"
  },
  "browserslist": [
    "last 3 versions",
    "ie >= 11"
